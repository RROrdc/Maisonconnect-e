# ============================================================================
#  Ce qui ne part JAMAIS sur GitHub — même dans un dépôt privé.
#  Un dépôt privé se clone, se partage, se transfère : une clé exposée reste
#  exposée, et l'historique Git garde tout, même après suppression du fichier.
# ============================================================================

# --- SECRETS ---------------------------------------------------------------
# Clé API Anthropic et token Notion, en clair. `.env.example` sert de modèle.
.env
.env.local
*.pem
*.key

# --- DONNÉES DE LA FAMILLE -------------------------------------------------
# maison.db est la SEULE copie des données du foyer : menus, courses, tâches,
# emplois du temps des enfants, dates de naissance, appareils enrôlés.
# Elle se sauvegarde (sauvegarder-tout.cmd), elle ne se publie pas.
maison.db
maison.db-wal
maison.db-shm
sauvegardes/
*.db
*.db-wal
*.db-shm

# --- SORTIES GÉNÉRÉES CONTENANT DES DONNÉES DU FOYER -----------------------
# outils/marqueurs-vacances.js produit un .ics avec les dates de garde des
# enfants. C'est un fichier de travail, à importer puis à jeter — pas du code.
*.ics

# --- PHOTOS DE PLATS -------------------------------------------------------
# ~8,5 Mo récupérés sur des sites de cuisine : ce n'est pas à nous de les
# redistribuer, et elles se régénèrent en un clic (/admin/ → Repas →
# « Trouver les photos manquantes »).
public/plats/

# --- SECRET D'APPAREIL ECOLEDIRECTE ----------------------------------------
# ecole/etat*.json contient le couple cn/cv qui prouve au serveur que CETTE
# machine est un appareil validé, plus les réponses au QCM de sécurité.
# C'est l'équivalent d'un second facteur déjà franchi : ça ne se publie pas,
# et ça ne se copie pas non plus d'une machine à l'autre.
ecole/etat*.json
# Identifiants permanents Pronote, issus de l'echange du QR code : ils valent
# le compte lui-meme, et tournent a chaque connexion (reecrits sur place).
ecole/pronote-identifiants.json

# --- ARTEFACTS PYTHON ------------------------------------------------------
# Le pont Pronote est du Python : son bytecode compilé est propre à CETTE
# machine et à SA version de Python. Il n'a aucune valeur dans le dépôt et
# provoquerait des conflits sur le Mac.
__pycache__/
*.pyc

# --- DÉPENDANCES -----------------------------------------------------------
# `npm ci` les reconstruit à l'identique depuis package-lock.json.
node_modules/

# --- LOCAL À CETTE MACHINE -------------------------------------------------
.claude/settings.local.json
*.log
*.zip
*.tar.gz
_ap-*.html

# Réglages du kiosque, propres à CET écran (adresse du serveur, délai d'attente).
# Le script kiosque.sh est versionné, sa configuration non : rien de spécifique
# au foyer dans le code (§ 5 quater).
outils/raspberry/kiosque.conf

# --- SYSTÈME ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
