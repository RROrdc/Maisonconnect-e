# === Écran Maison — configuration ===
#
# Ce fichier est un MODÈLE. Copie-le en `.env` et remplis-le.
# ⚠️ Le `.env` ne part JAMAIS sur GitHub (voir .gitignore) : il contient des
#    secrets en clair, et l'historique Git garde tout, même après suppression.

# --- Ce qu'il faut connaître AVANT d'ouvrir la base -----------------------
# (le reste des réglages vit dans la base, éditable dans /admin/ → Réglages)
SOURCE=sqlite
# Laisser VIDE = `maison.db` à côté de server.js, quel que soit l'OS.
# ⚠️ Un chemin absolu du PC (C:/temp/…) n'existe pas sur le Mac : le serveur
#    y créerait une base VIDE sans le moindre message d'erreur (§ 2 septies).
DB_FICHIER=
# Le guide d'installation et toutes les adresses documentées utilisent 8090.
PORT=8090

# --- Secrets ---------------------------------------------------------------
# Un secret n'a rien à faire dans une base qu'on sauvegarde et qu'on recopie.
ANTHROPIC_API_KEY=

# --- Comptes scolaires ------------------------------------------------------
# Un couple par établissement : sans suffixe, puis _2, _3…
ED_IDENTIFIANT=
ED_MOTDEPASSE=
# ED_IDENTIFIANT_2=   ED_MOTDEPASSE_2=   ← second établissement
# Version d'API annoncée à EcoleDirecte. À renseigner SEULEMENT si le serveur
# répond 517 (« version invalide ») : le message d'erreur dit quoi y mettre.
ED_VERSION=
# Pronote passe par un pont Python. Sur le Mac, Homebrew installe `python3`.
# PYTHON_BIN=python3

# --- Notion : ARCHIVE FIGÉE, plus aucune écriture depuis le 18/08/2026 ------
# Utile seulement pour rejouer la migration (outils/migrer-notion-vers-sqlite.js).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_TODO=57a6d7ea-a726-496c-a06e-e370763fed1b
DB_COURSE=680422f3-b8b7-4aaf-92a4-a83d6ce25fe7
DB_POSTIT=45475d0c-9373-49b4-be05-8b19b2a1df9d
DB_MENU=03d7983a-3f79-4e52-966f-79489f550db0
DB_PLATS=251ae5b9-db0a-4c76-b2b8-76fe37e72a6f
DB_PLANNING=3bb3afd4-c0de-8138-b241-f7ab63995670

# --- Amorçage uniquement ----------------------------------------------------
# Ces valeurs sont recopiées EN BASE au premier démarrage, puis c'est /admin/
# qui commande. Les vider ici ensuite ne change plus rien (§ 2 septies).
CAL_ICS_URL=
PLANNING_EXEMPLE=0
