# === Ã‰cran Maison â€” configuration ===
# Copie ce fichier en ".env" et remplis les valeurs.
# Le .env est lu depuis le DOSSIER DU PROJET, quel que soit le rÃ©pertoire de lancement.

# 0) Source des donnÃ©es
#    sqlite = la base maison.db (la cible, depuis la bascule du 18/08/2026)
#    notion = l'ancien mode, conservÃ© pour la migration et comme filet de secours
SOURCE=sqlite
# Emplacement de la base. UN SEUL FICHIER : le sauvegarder, c'est sauvegarder toute la maison.
# Laisse vide pour utiliser maison.db Ã  la racine du projet.
DB_FICHIER=

# --- Ce qui suit ne sert plus qu'avec SOURCE=notion (ou pour rejouer la migration) ---

# 1) ClÃ© d'intÃ©gration Notion (https://www.notion.so/my-integrations â†’ New integration â†’ Internal Integration Secret)
#    Puis, dans Notion, partage la page "ðŸ  Maison" (et ses bases) avec cette intÃ©gration.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Identifiants des bases (dÃ©jÃ  renseignÃ©s â€” ce sont TES bases Maison)
DB_TODO=57a6d7ea-a726-496c-a06e-e370763fed1b
DB_COURSE=680422f3-b8b7-4aaf-92a4-a83d6ce25fe7
DB_POSTIT=45475d0c-9373-49b4-be05-8b19b2a1df9d
DB_MENU=03d7983a-3f79-4e52-966f-79489f550db0
DB_PLATS=251ae5b9-db0a-4c76-b2b8-76fe37e72a6f
DB_PLANNING=3bb3afd4-c0de-8138-b241-f7ab63995670

# Bandeau Â« donnÃ©es d'exemple Â» sur les plannings enfants (1 = affichÃ©, 0 = masquÃ©)
PLANNING_EXEMPLE=1

# 3) (Optionnel) Agenda perso en lecture : URL d'abonnement iCloud/Google au format .ics
#    Laisse vide pour l'instant si tu ne l'as pas â€” l'agenda s'affichera vide.
CAL_ICS_URL=

# 4) Port du serveur
#    L'Ã©cran mural ouvrira  http://IP-DU-SERVEUR:PORT/bento.html
#    Les iPhone ouvriront   http://IP-DU-SERVEUR:PORT/app/
PORT=8080

# --- Recettes ---
# Clé API Anthropic : active la recherche de recette par nom de plat et la lecture
# d'une photo de recette. Sans elle, seule la source ' lien ' fonctionne.
ANTHROPIC_API_KEY=
# Modèle utilisé (defaut : claude-opus-5). claude-haiku-4-5 est moins cher.
#IA_MODELE=claude-opus-5
