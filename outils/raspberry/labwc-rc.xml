<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <libinput>
    <device category="touch">
      <!-- L'écran est pivoté (transform 90) mais les coordonnées du tactile,
           elles, sortent toujours dans le repère physique de la dalle.
           `mapToOutput` seul n'a pas suffi — vérifié sur ce Pi, à travers un
           redémarrage complet. On force donc la rotation des coordonnées.
           Matrice de rotation 90° : 0 -1 1 / 1 0 0 -->
      <mapToOutput>HDMI-A-1</mapToOutput>
      <calibrationMatrix>0 -1 1 1 0 0</calibrationMatrix>
    </device>
  </libinput>
  <keyboard>
    <!-- Porte de sortie du kiosque : arrête le SCRIPT, pas seulement Chromium
         (qui repartirait au bout de 5 s). -->
    <keybind key="C-A-Q">
      <action name="Execute"><command>sh -c "pkill -f kiosque.sh; pkill chromium"</command></action>
    </keybind>
  </keyboard>
</openbox_config>
